# Copy to .envrc, edit these defaults for this machine, then run: direnv allow .
# This activates an existing environment; it does not install dependencies.
export PIH3L_CONDA_BASE="${PIH3L_CONDA_BASE:-/opt/anaconda3}"
export PIH3L_CONDA_ENV="${PIH3L_CONDA_ENV:-MLenv}"

if [[ ! -r "$PIH3L_CONDA_BASE/etc/profile.d/conda.sh" ]]; then
  log_error "Set PIH3L_CONDA_BASE to a visible Conda/Miniforge installation."
  return 1
fi
source "$PIH3L_CONDA_BASE/etc/profile.d/conda.sh" || return 1
conda activate "$PIH3L_CONDA_ENV" || return 1

# Keep project imports ahead of installed copies while preserving other paths.
path_add PYTHONPATH "$PWD/src"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-2}"
export MPLBACKEND=Agg
export MPLCONFIGDIR="${MPLCONFIGDIR:-$PWD/.direnv/matplotlib}"
mkdir -p "$MPLCONFIGDIR" || return 1
